# Proxmox API (optional fallback — prefer Setup tab in the dashboard)
PROXMOX_HOST=https://192.168.1.10:8006
PROXMOX_TOKEN_ID=root@pam!alexa
PROXMOX_TOKEN_SECRET=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# Optional: password for user@realm (before !). Used to auto-repair token ACLs
# when Privilege Separation blocks Sys.Audit on /nodes/*/status.
# PROXMOX_AUTH_PASSWORD=

# Force demo data even if credentials are set
PROXMOX_MOCK=false

# Most home Proxmox installs use a self-signed cert.
# When connecting live, also set:
# NODE_TLS_REJECT_UNAUTHORIZED=0
PROXMOX_ALLOW_SELF_SIGNED=true

# Where the web UI stores saved servers (API URL + tokens).
# LXC/production default is /var/lib/voxmox (survives app updates).
# Dev default is ./data when unset.
# VOXMOX_DATA_DIR=/var/lib/voxmox

# Optional: reject Alexa requests that are not from your skill
ALEXA_SKILL_ID=amzn1.ask.skill.xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Set true only for local curl tests against /api/alexa
# (development mode already skips signature checks)
ALEXA_SKIP_SIGNATURE_VALIDATION=false
