# Proxmox API (optional fallback — prefer Setup tab in the dashboard)
PROXMOX_HOST=https://192.168.1.10:8006
PROXMOX_TOKEN_ID=root@pam!alexa
PROXMOX_TOKEN_SECRET=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# Optional: password for user@realm (before !). Used to auto-repair token ACLs
# when Privilege Separation blocks Sys.Audit on /nodes/*/status.
# PROXMOX_AUTH_PASSWORD=

# Dashboard unlock secret (locks Setup / power / cluster APIs).
# LXC install/update auto-generates one into /etc/voxmox/dashboard.secret
# VOXMOX_DASHBOARD_SECRET=change-me
# VOXMOX_ALLOW_ANONYMOUS=1

# Encrypt tokenSecret / authPassword at rest in servers.json (AES-256-GCM).
# Prefer a dedicated 64-char hex key (32 bytes). A passphrase also works (scrypt).
# When unset, Voxmox derives a key from VOXMOX_DASHBOARD_SECRET; if neither is set,
# secrets are stored in plaintext (dev only — production logs a warning on write).
# VOXMOX_SECRETS_KEY=

# Force demo data even if credentials are set
PROXMOX_MOCK=false

# Most home Proxmox installs use a self-signed cert.
# Self-signed TLS is handled per-request when this is true (or per saved server).
# NODE_TLS_REJECT_UNAUTHORIZED is no longer required / recommended.
PROXMOX_ALLOW_SELF_SIGNED=true

# Where the web UI stores saved servers (API URL + tokens).
# LXC/production default is /var/lib/voxmox (survives app updates).
# Dev default is ./data when unset.
# VOXMOX_DATA_DIR=/var/lib/voxmox

# Optional: reject Alexa requests that are not from your skill
ALEXA_SKILL_ID=amzn1.ask.skill.xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Set true only for local curl tests against /api/alexa
# (development mode already skips signature checks; ignored in production)
ALEXA_SKIP_SIGNATURE_VALIDATION=false

# Service split (same build, different processes/ports for Cloudflare Access):
#   all       — UI + every API on one port (default / local `npm run start`)
#   dashboard — UI + control-plane APIs (port 43127 on LXC)
#   api       — Alexa skill endpoint only (port 43128 on LXC)
# VOXMOX_SERVICE_MODE=all
# DASHBOARD_PORT=43127
# API_PORT=43128
