#!/usr/bin/env bash
# ==============================================================================
# Voxmox / voxmox updater
# Installed as /usr/bin/update inside the LXC (community-scripts style).
# Usage (as root inside the CT):
#   update
#   update --full              # also apt upgrade OS packages
#   update --set-url 'https://github.com/tr0lls3c/voxmox.git'
#   update --set-url 'https://ghp_xxx@github.com/tr0lls3c/voxmox.git'   # private repo PAT
# ==============================================================================
set -euo pipefail

APP="Voxmox"
APP_DIR="${APP_DIR:-/opt/voxmox}"
APP_USER="${APP_USER:-voxmox}"
CONF_DIR="/etc/voxmox"
CONF_FILE="${CONF_DIR}/update.conf"
LOCK_HASH_FILE="${CONF_DIR}/package-lock.sha256"
SERVICE_NAME="voxmox"
DEFAULT_GIT_URL="https://github.com/tr0lls3c/voxmox.git"
FULL_OS_UPDATE=0

YW=$'\033[33m'
BL=$'\033[36m'
GN=$'\033[1;92m'
RD=$'\033[01;31m'
CL=$'\033[m'
BOLD=$'\033[1m'

msg_info() { echo -e " ${BOLD}${YW}➜${CL}  $1"; }
msg_ok() { echo -e " ${BOLD}${GN}✔${CL}  $1"; }
msg_error() { echo -e " ${BOLD}${RD}✖${CL}  $1"; }
header_info() {
  clear
  cat <<"EOF"
#     # ####### #     # #     # ####### #     #
#     # #     #  #   #  ##   ## #     #  #   #
#     # #     #   # #   # # # # #     #   # #
#     # #     #    #    #  #  # #     #    #
 #   #  #     #   # #   #     # #     #   # #
  # #   #     #  #   #  #     # #     #  #   #
   #    ####### #     # #     # ####### #     #
EOF
  echo -e "  ${BL}${APP} updater${CL}\n"
}

die() {
  msg_error "$1"
  exit 1
}

load_conf() {
  GIT_URL="${VOXMOX_GIT_URL:-}"
  GIT_BRANCH="${GIT_BRANCH:-main}"
  NODE_MAJOR="${NODE_MAJOR:-22}"

  if [[ -f "$CONF_FILE" ]]; then
    # shellcheck disable=SC1090
    source "$CONF_FILE"
  fi

  [[ -n "${VOXMOX_GIT_URL:-}" ]] && GIT_URL="$VOXMOX_GIT_URL"
  [[ -n "${GIT_BRANCH_OVERRIDE:-}" ]] && GIT_BRANCH="$GIT_BRANCH_OVERRIDE"

  # Sensible default for public GitHub installs.
  if [[ -z "${GIT_URL:-}" ]]; then
    GIT_URL="$DEFAULT_GIT_URL"
  fi
}

save_conf() {
  mkdir -p "$CONF_DIR"
  cat >"$CONF_FILE" <<EOF
# Voxmox update configuration (chmod 600)
# Generated/updated by /usr/bin/update
GIT_URL='${GIT_URL}'
GIT_BRANCH='${GIT_BRANCH}'
APP_DIR='${APP_DIR}'
APP_USER='${APP_USER}'
NODE_MAJOR='${NODE_MAJOR:-22}'
EOF
  chmod 600 "$CONF_FILE"
}

ensure_root() {
  [[ $EUID -eq 0 ]] || die "Run update as root inside the Voxmox LXC."
}

ensure_install() {
  if [[ ! -d "$APP_DIR" || ! -f "$APP_DIR/package.json" ]]; then
    die "No ${APP} installation found in ${APP_DIR}."
  fi
  if ! systemctl list-unit-files "${SERVICE_NAME}.service" &>/dev/null; then
    die "systemd unit ${SERVICE_NAME}.service not found."
  fi
}

cmd_set_url() {
  local url="${1:-}"
  [[ -n "$url" ]] || die "Usage: update --set-url '<git-clone-url>'"
  load_conf
  GIT_URL="$url"
  save_conf
  msg_ok "Saved update URL to ${CONF_FILE}"
  exit 0
}

ensure_nodejs() {
  if command -v node >/dev/null 2>&1; then
    local major
    major="$(node -v | sed -E 's/^v([0-9]+).*/\1/')"
    if [[ "$major" -ge "${NODE_MAJOR:-22}" ]]; then
      return
    fi
  fi
  msg_info "Updating Node.js to ${NODE_MAJOR}.x"
  export DEBIAN_FRONTEND=noninteractive
  curl -fsSL "https://deb.nodesource.com/setup_${NODE_MAJOR}.x" | bash -
  apt-get install -y nodejs
  msg_ok "Node.js $(node -v)"
}

# Fast path: only install missing tools. Full OS upgrade is opt-in (--full).
ensure_tools() {
  export DEBIAN_FRONTEND=noninteractive
  local missing=()
  local cmd
  for cmd in git rsync curl; do
    command -v "$cmd" >/dev/null 2>&1 || missing+=("$cmd")
  done

  if [[ "$FULL_OS_UPDATE" == "1" ]]; then
    msg_info "Updating OS packages (--full)"
    apt-get update -y >/dev/null
    apt-get -y upgrade >/dev/null
    apt-get install -y --no-install-recommends git rsync curl ca-certificates >/dev/null
    msg_ok "Updated OS packages"
    return
  fi

  if ((${#missing[@]} > 0)); then
    msg_info "Installing missing tools: ${missing[*]}"
    apt-get update -y >/dev/null
    apt-get install -y --no-install-recommends "${missing[@]}" ca-certificates >/dev/null
    msg_ok "Tools installed"
  else
    msg_ok "Build tools present (skip apt upgrade — pass --full to upgrade OS)"
  fi
}

fetch_latest() {
  [[ -n "${GIT_URL:-}" ]] || die "No git URL configured. Run: update --set-url 'https://github.com/tr0lls3c/voxmox.git'"

  msg_info "Fetching ${APP} (${GIT_BRANCH}) from git"
  TMP="$(mktemp -d)"
  # shellcheck disable=SC2064
  trap "rm -rf '$TMP'" EXIT

  if ! git clone --depth 1 --branch "$GIT_BRANCH" "$GIT_URL" "$TMP/src" 2>"$TMP/clone.err"; then
    echo
    cat "$TMP/clone.err" >&2 || true
    echo
    die "Git clone failed.

For a public GitHub repo:
  update --set-url 'https://github.com/tr0lls3c/voxmox.git'

For a private GitHub repo (classic PAT with repo scope):
  update --set-url 'https://ghp_YOUR_PAT@github.com/tr0lls3c/voxmox.git'"
  fi

  rm -rf "$TMP/src/.git"

  rsync -a --delete \
    --exclude node_modules \
    --exclude .next \
    --exclude .env \
    --exclude .env.local \
    --exclude data \
    "$TMP/src/" "$APP_DIR/"

  mkdir -p "$APP_DIR/data"
  chown -R "$APP_USER:$APP_USER" "$APP_DIR"
  msg_ok "Application files updated"
}

lockfile_hash() {
  if [[ -f "$APP_DIR/package-lock.json" ]]; then
    sha256sum "$APP_DIR/package-lock.json" | awk '{print $1}'
  else
    echo "none"
  fi
}

install_deps_and_build() {
  cd "$APP_DIR"
  local new_hash prev_hash
  new_hash="$(lockfile_hash)"
  prev_hash="$(cat "$LOCK_HASH_FILE" 2>/dev/null || true)"

  if [[ -d node_modules ]] && [[ -n "$prev_hash" ]] && [[ "$new_hash" == "$prev_hash" ]]; then
    msg_ok "Dependencies unchanged — skipping npm ci"
  else
    msg_info "Installing npm dependencies"
    if [[ -f package-lock.json ]]; then
      runuser -u "$APP_USER" -- npm ci --prefer-offline --no-audit --no-fund
    else
      runuser -u "$APP_USER" -- npm install --no-audit --no-fund
    fi
    mkdir -p "$CONF_DIR"
    echo "$new_hash" >"$LOCK_HASH_FILE"
    msg_ok "Dependencies installed"
  fi

  msg_info "Building ${APP}"
  runuser -u "$APP_USER" -- npm run build
  msg_ok "Build complete"
}

# Keep systemd unit in sync so ExecStart stays on the fast direct next binary.
refresh_systemd_unit() {
  local unit="/etc/systemd/system/${SERVICE_NAME}.service"
  local port
  port="$(systemctl show -p Environment --value "$SERVICE_NAME" 2>/dev/null | tr ' ' '\n' | sed -n 's/^PORT=//p' | tail -1)"
  port="${port:-43127}"

  if [[ -f "$APP_DIR/scripts/lxc/voxmox.service" ]]; then
    msg_info "Refreshing systemd unit"
    cp "$APP_DIR/scripts/lxc/voxmox.service" "$unit"
    sed -i \
      -e "s|__APP_DIR__|${APP_DIR}|g" \
      -e "s|__APP_USER__|${APP_USER}|g" \
      -e "s|__APP_PORT__|${port}|g" \
      "$unit"
    systemctl daemon-reload
    msg_ok "systemd unit refreshed"
  fi
}

restart_service() {
  refresh_systemd_unit
  msg_info "Starting ${SERVICE_NAME}"
  systemctl start "$SERVICE_NAME"
  # next start (direct binary) is usually ready in <2s; poll instead of fixed sleep.
  local i
  for i in $(seq 1 20); do
    if systemctl is-active --quiet "$SERVICE_NAME"; then
      msg_ok "Started ${SERVICE_NAME}"
      return 0
    fi
    sleep 0.25
  done
  systemctl --no-pager --full status "$SERVICE_NAME" || true
  die "${SERVICE_NAME} failed to start — check: journalctl -u ${SERVICE_NAME} -n 100"
}

run_update() {
  header_info
  ensure_root
  ensure_install
  load_conf

  if [[ -n "${VOXMOX_GIT_URL:-}" ]]; then
    GIT_URL="$VOXMOX_GIT_URL"
    save_conf
  fi

  ensure_tools
  ensure_nodejs

  msg_info "Stopping ${SERVICE_NAME}"
  systemctl stop "$SERVICE_NAME" || true
  msg_ok "Stopped ${SERVICE_NAME}"

  fetch_latest
  install_deps_and_build
  restart_service
  save_conf

  echo
  msg_ok "Updated ${APP} successfully!"
  local safe_url
  safe_url="$(echo "$GIT_URL" | sed -E 's#https://[^@/]+@#https://#')"
  echo -e "  ${BOLD}App:${CL}     ${APP_DIR}"
  echo -e "  ${BOLD}Source:${CL}  ${safe_url}"
  echo -e "  ${BOLD}Branch:${CL}  ${GIT_BRANCH}"
  echo -e "  ${BOLD}Service:${CL} systemctl status ${SERVICE_NAME}"
  echo
}

usage() {
  cat <<EOF
Usage: update [options]

Update ${APP} (voxmox) application code, npm dependencies, and restart the service.

Options:
  --full            Also run apt update/upgrade (slow; off by default)
  --set-url <url>   Save the git clone URL used for future updates
  -h, --help        Show this help

Examples:
  update
  update --full
  update --set-url 'https://github.com/tr0lls3c/voxmox.git'
  update --set-url 'https://ghp_YOUR_PAT@github.com/tr0lls3c/voxmox.git'
EOF
}

main() {
  case "${1:-}" in
    -h | --help)
      usage
      ;;
    --full)
      FULL_OS_UPDATE=1
      run_update
      ;;
    --set-url)
      cmd_set_url "${2:-}"
      ;;
    "")
      run_update
      ;;
    *)
      usage
      die "Unknown option: $1"
      ;;
  esac
}

main "$@"
